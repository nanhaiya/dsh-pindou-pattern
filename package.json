{
  "name": "dsh-pindou-pattern",
  "version": "0.1.0",
  "displayName": "Bead Pattern Studio",
  "description": "拼豆图纸工坊 — turn any image into a bead pattern with the full MARD color catalog · 图片生成拼豆图纸，支持自定义尺寸与 MARD 色号",
  "type": "module",
  "license": "MIT",
  "author": "pindou-pattern contributors",
  "icon": "icon.svg",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "beads",
    "perler",
    "pixel-art",
    "mard",
    "拼豆"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check client.js && node test/engine.test.cjs",
    "prepublishOnly": "node build.mjs && node test/engine.test.cjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
